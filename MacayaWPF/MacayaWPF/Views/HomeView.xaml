<UserControl x:Class="MacayaWPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:MacayaWPF.ViewModels"
             Background="White">
    
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="SmartPhone Management System" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#007ACC" 
                       Margin="0,0,0,30"/>
            
            <Button Content="Manage SmartPhones" 
                    Command="{Binding NavigateToSmartPhoneManagementCommand}"
                    Width="250" 
                    Height="50" 
                    FontSize="18"
                    Background="#007ACC" 
                    Foreground="White" 
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="10" 
                                            Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
